# Motor de emisión. En local `pnpm dev` rellena estos valores automáticamente.
API_URL=http://127.0.0.1:8787
ENGINE_TOKEN=            # el mismo secreto que la API (mínimo 24 caracteres)
CAPACITY=2               # canales simultáneos por nodo
DATA_DIR=.data/engine    # caché de vídeos y trabajo temporal
ENGINE_ROLE=all          # all | media | stream
# FFMPEG_PATH= / FFPROBE_PATH=   (por defecto: binarios de npm en desarrollo, PATH en producción)
# CACHE_MAX_BYTES=21474836480    TRANSCODE_THREADS=0    LOG_LEVEL=info
