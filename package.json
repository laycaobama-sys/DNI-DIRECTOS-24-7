{
  "name": "dni-directos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @dni/api dev",
    "dev:engine": "pnpm --filter @dni/engine dev",
    "dev:web": "pnpm --filter @dni/web dev",
    "db:migrate": "pnpm --filter @dni/api db:migrate",
    "build": "pnpm --filter @dni/web build && pnpm --filter @dni/engine build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e-stream": "tsx scripts/e2e-stream.ts",
    "tools:setup": "node scripts/setup-tools.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
